# Copie para .env. Nunca compartilhe tokens, senhas ou códigos de verificação.
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/central.sqlite
# Anexos ficam no mesmo SQLite. Limite lógico total em MB (1 a 500), sem exclusão automática.
MEDIA_STORAGE_MAX_MB=500
# Integração própria com o Notion; o conector deste chat não fornece credenciais ao servidor.
# Ative apenas após conferir o acesso às bases. Não altera o modo do WhatsApp.
NOTION_ENABLED=false
NOTION_TOKEN=
NOTION_CLIENTS_DATA_SOURCE_ID=
NOTION_HISTORY_DATA_SOURCE_ID=
# Fontes operacionais opcionais para o painel de contexto.
NOTION_WORKS_DATA_SOURCE_ID=
NOTION_PROPOSALS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_SUPPLIERS_DATA_SOURCE_ID=
# Referencia geral de servicos para atendimento, pagina especifica autorizada no Notion.
# A leitura e somente de secoes publicas de triagem, sem precos e sem contratos.
NOTION_GLOBAL_CONTEXT_PAGE_ID=
# Intervalo de atualizacao automatica (30 a 3600 segundos); padrao 60.
NOTION_GLOBAL_CONTEXT_TTL_SECONDS=60
# Chat interno de operadores com Custom Agent real do Notion. Desligado até conferir acesso e créditos.
NOTION_OPERATOR_CHAT_ENABLED=false
NOTION_OPERATOR_AGENT_ID=
# Opcional: credencial restrita ao agente. Vazio reutiliza NOTION_TOKEN, sem expor no navegador.
NOTION_AGENT_TOKEN=
# Atendimento IA: desligado até configurar piloto e autorizar consumo.
OPENAI_API_KEY=
AI_ENABLED=false
AI_ALLOW_ALL_CONTACTS=false
# Telefones autorizados com país e DDD, somente dígitos, separados por vírgula.
# Opcional: numeros internos da direcao, somente digitos com DDI. Nao autoriza acesso a documentos.
# Numeros listados nao recebem IA de atendimento externo ou cadastro automatico.
# Deixar vazio ate validar identidade, riscos e permissoes do numero em producao.
DIRECTION_CONTACT_PHONES=
# Fila interna de decisoes de direcao. Desligada por padrao, sem envios automaticos.
# Deve corresponder ao email de login da conta ADMIN autenticada, configurado em segredo no Render.
DIRECTION_ESCALATION_ENABLED=false
DIRECTION_APPROVER_EMAIL=
AI_ALLOWED_PHONES=
# Zero bloqueia chamadas de modelo. Teto local em USD, de 0 a 100, por mês UTC.
AI_MONTHLY_BUDGET_USD=0
# Teto total do teste, sem renovação mensal. Zero mantém o teste bloqueado.
AI_TOTAL_BUDGET_USD=0
# Cadastro inicial automático: restrito aos contatos autorizados, com fonte dos dados conferida.
AI_AUTO_REGISTER=false
# Retomada opcional apos resposta humana enviada pelo WhatsApp Business.
# Desligado por padrao. A pausa e de 60 minutos desde o ultimo eco recebido.
# Nao responde mensagens antigas: aguarda uma NOVA mensagem do cliente.
# Pedidos de humano, atribuicao de atendente e bloqueios manuais nao expiram.
AI_BUSINESS_ECHO_AUTO_RESUME_ENABLED=false
AI_BUSINESS_ECHO_RESUME_MINUTES=60
# Transcrição automática de mensagens de voz OGG/Opus, dentro do mesmo teto de IA.
AI_AUDIO_ENABLED=false
NOTION_CLIENT_SUMMARY_ENABLED=false
# Vincular todo contato recebido e criar cadastro inicial sem depender da IA ou da agenda local.
# Contatos já classificados como fornecedores seguem a base separada de fornecedores.
NOTION_AUTO_REGISTER_CONTACTS=false
# Conexão de servidor para o agente do Notion: credencial própria, mínimo 32 caracteres.
CENTRAL_MCP_ENABLED=false
CENTRAL_MCP_TOKEN=
# Escopo explícito; vazio não concede acesso a nenhuma conversa.
CENTRAL_MCP_ALLOWED_PHONES=
# Habilitar somente após configurar confirmar_envio para pedir confirmação no Notion.
CENTRAL_MCP_SEND_ENABLED=false
# ChatGPT: autenticação OAuth separada, com login administrativo e MCP somente leitura.
# Desativado por padrão. Não reutiliza CENTRAL_MCP_TOKEN nem amplia telefones permitidos.
CHATGPT_OAUTH_ENABLED=false
# E-mail EXATO do administrador ativo da Central autorizado a conectar esta integração.
CHATGPT_OAUTH_ADMIN_EMAIL=
# Escopo adicional do ChatGPT. Comece com um único número de teste, também permitido em CENTRAL_MCP_ALLOWED_PHONES.
# Sem este valor, o piloto fica desligado (exceto com opt-in explícito de leitura completa abaixo).
# Não herda automaticamente o escopo do Notion.
CHATGPT_OAUTH_ALLOWED_PHONES=
# Liberação administrativa explícita de leitura de todas as conversas e agenda.
# Não habilita escrita/envio nem altera a lista do canal Notion. Exige novo login.
CHATGPT_OAUTH_READ_ALL_CONTACTS=false
# Somente homologação: classificação administrativa por conversa e assunto.
# Habilitar exige revisão de cada contato externo/demanda antes da automação.
CONTEXT_CLASSIFICATION_ENABLED=false
# Restringe o MCP legado a somente leitura se ativado (também afeta os agentes Notion).
CENTRAL_MCP_READ_ONLY=false
# Assistente interno OpenAI: chave e teto compartilhados com o atendimento.
# Desligado até publicar e conferir os limites existentes. Não usa créditos do agente Notion.
OPERATOR_AI_ENABLED=false
# demo não envia mensagens reais. live exige todas as credenciais abaixo.
WHATSAPP_MODE=demo
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
# Use a versão suportada pelo seu aplicativo Meta.
META_GRAPH_VERSION=
# Cadastro de coexistência: identificadores públicos, separados do número ativo.
META_APP_ID=
META_LOGIN_CONFIG_ID=
# Número do Business com país e DDD, somente dígitos, conforme retornado pela Meta.
META_COEXISTENCE_PHONE_NUMBER=
# Retomada apos 24h somente via modelo aprovado. Desligado por padrao.
# Requer WABA ID do negocio, template estatico aprovado pela Meta e consentimento registrado.
# Nao aceita corpo, variaveis, anexos ou destinatario arbitrarios na API de envio.
WHATSAPP_REENGAGEMENT_ENABLED=false
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_REENGAGEMENT_TEMPLATE_NAME=
WHATSAPP_REENGAGEMENT_TEMPLATE_LANGUAGE=pt_BR
# Obrigatório para instalar em servidor remoto. Defina um valor aleatório longo.
SETUP_TOKEN=
# Notificações externas opcionais, enviadas pelo servidor enquanto estiver ativo.
# O destino deve ser um serviço sob seu controle que entregue os avisos à equipe.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
