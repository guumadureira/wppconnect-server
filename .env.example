# Copie para .env. Nunca compartilhe tokens, senhas ou códigos de verificação.
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/central.sqlite
# demo não envia mensagens reais. live exige todas as credenciais abaixo.
WHATSAPP_MODE=demo
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
# Use a versão suportada pelo seu aplicativo Meta.
META_GRAPH_VERSION=
# Obrigatório para instalar em servidor remoto. Defina um valor aleatório longo.
SETUP_TOKEN=
# Notificações externas opcionais, enviadas pelo servidor enquanto estiver ativo.
# O destino deve ser um serviço sob seu controle que entregue os avisos à equipe.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
